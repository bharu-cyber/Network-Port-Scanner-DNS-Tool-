<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Night Tree // Port Scan + DNS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#050810; --ink-2:#0d1420; --paper:#E8F0FA;
    --teal:#2DD4BF; --blue:#3B82F6; --silver:#94A3B8; --indigo:#818CF8;
    --border:#1e293b; --muted:#7b8aa3;
    --pend:#A5F3FC; --open:#22D3EE; --closed:#1E3A5F;
    --mono:'IBM Plex Mono', monospace; --sans:'Inter', sans-serif;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ background:var(--ink); height:100%; font-family:var(--sans); color:var(--paper); }
  body{ overflow-y:scroll; overflow-x:hidden; scroll-snap-type:y proximity; }
  #canvas-wrap{ position:fixed; inset:0; z-index:0; }
  canvas{ display:block; touch-action:pan-y; }

  .section{ position:relative; z-index:1; min-height:100vh; width:100%; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; scroll-snap-align:start; padding:20px 20px 28px; text-align:center; pointer-events:none; }
  .caption-bar{ background:rgba(5,8,16,0.72); border:1px solid var(--border); border-radius:14px; backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); padding:14px 18px; max-width:400px; width:100%; }
  .card{ pointer-events:auto; }

  h1{ font-family:var(--mono); font-weight:700; font-size:clamp(24px, 6vw, 34px); letter-spacing:1px; margin-bottom:6px; color:var(--paper); text-shadow:0 0 18px rgba(45,212,191,0.3); }
  h1 span{ color:var(--teal); }
  .tagline{ font-family:var(--mono); font-size:10.5px; color:var(--teal); letter-spacing:2px; text-transform:uppercase; margin-bottom:10px; opacity:0.9; }
  .body-text{ max-width:400px; color:var(--muted); font-size:12.5px; line-height:1.55; margin-bottom:8px; }

  .card{ background:rgba(13,20,32,0.65); border:1px solid var(--border); border-radius:14px; padding:22px; backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); width:100%; max-width:340px; }
  .card label{ display:block; font-family:var(--mono); font-size:11px; color:var(--teal); text-align:left; margin-bottom:5px; letter-spacing:1px; }
  .card input{ width:100%; background:var(--ink); border:1px solid var(--border); border-radius:7px; padding:11px 12px; color:var(--paper); font-family:var(--mono); font-size:14px; margin-bottom:12px; }
  .card input:focus{ outline:2px solid var(--teal); border-color:transparent; }
  .row2{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .btn{ width:100%; font-family:var(--mono); font-weight:700; font-size:13.5px; background:linear-gradient(90deg, var(--blue), var(--teal)); color:#031014; border:none; border-radius:8px; padding:13px; cursor:pointer; margin-top:4px; box-shadow:0 6px 24px rgba(45,212,191,0.3); }
  .btn:active{ transform:scale(0.97); }

  .scroll-hint{ margin-top:24px; font-family:var(--mono); font-size:11px; color:var(--muted); display:flex; flex-direction:column; align-items:center; gap:6px; animation:bob 1.8s ease-in-out infinite; }
  .scroll-hint .arrow{ font-size:15px; color:var(--teal); }
  @keyframes bob{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(6px); } }

  .sec-eyebrow{ font-family:var(--mono); font-size:10px; color:var(--teal); letter-spacing:2px; text-transform:uppercase; margin-bottom:6px; }
  .sec-heading{ font-family:var(--mono); font-size:clamp(17px,4vw,22px); font-weight:700; margin:0 0 8px; }
  .sec-heading em{ font-style:normal; color:var(--indigo); }

  .hud{ position:absolute; top:20px; left:20px; z-index:10; text-align:left; max-width:230px; background:rgba(5,8,16,0.6); border:1px solid var(--border); border-radius:10px; padding:12px 14px; backdrop-filter:blur(8px); opacity:0; transition:opacity .3s linear; pointer-events:none; }
  .hud h2{ font-family:var(--mono); font-size:13px; color:var(--teal); margin:0 0 4px; }
  .hud p{ font-family:var(--mono); font-size:10.5px; color:var(--muted); margin:0; line-height:1.5; }

  .status{ position:absolute; top:20px; right:20px; z-index:10; text-align:right; color:var(--teal); font-size:12px; font-family:var(--mono); background:rgba(5,8,16,0.6); border:1px solid var(--border); border-radius:10px; padding:12px 16px; min-width:150px; backdrop-filter:blur(8px); opacity:0; transition:opacity .3s linear; pointer-events:none; }
  .status .big{ color:var(--indigo); font-size:20px; font-weight:700; }
  .status .row{ display:flex; justify-content:space-between; gap:12px; font-size:11px; margin-top:5px; color:var(--muted); }
  .status .row b{ color:var(--paper); font-weight:500; }

  .legend{ position:absolute; bottom:20px; left:20px; z-index:10; display:flex; flex-wrap:wrap; gap:10px; max-width:280px; font-size:10.5px; font-family:var(--mono); color:var(--paper); background:rgba(5,8,16,0.6); border:1px solid var(--border); border-radius:8px; padding:8px 12px; backdrop-filter:blur(8px); opacity:0; transition:opacity .3s linear; pointer-events:none; }
  .legend span{ display:inline-flex; align-items:center; gap:5px; }
  .dot{ width:8px; height:8px; border-radius:50%; display:inline-block; box-shadow:0 0 8px currentColor; }

  #fruitInfo{ position:fixed; left:50%; bottom:60px; transform:translateX(-50%); z-index:30; padding:18px 24px; text-align:center; min-width:220px; background:rgba(5,8,16,0.82); border:1px solid var(--border); border-radius:14px; backdrop-filter:blur(10px); opacity:0; pointer-events:none; transition:opacity 0.25s ease; }
  #fruitInfo.show{ opacity:1; pointer-events:auto; }
  #fruitInfo .port-num{ font-family:var(--mono); font-size:26px; font-weight:700; }
  #fruitInfo .port-name{ font-family:var(--mono); font-size:12px; color:var(--muted); margin-top:2px; }
  #fruitInfo .port-desc{ font-family:var(--mono); font-size:11px; color:var(--silver); margin-top:8px; max-width:260px; line-height:1.5; }
  #fruitInfo .port-status{ font-family:var(--mono); font-size:13px; font-weight:700; margin-top:8px; letter-spacing:1px; }
  #backBtn{ margin-top:14px; font-family:var(--mono); font-size:12px; font-weight:600; background:transparent; color:var(--paper); border:1px solid var(--border); border-radius:6px; padding:8px 16px; cursor:pointer; }

  .stat-grid{ display:grid; grid-template-columns:1fr 1fr; gap:12px; width:100%; max-width:340px; margin:18px 0; }
  .stat{ background:rgba(13,20,32,0.6); border:1px solid var(--border); border-radius:10px; padding:16px; text-align:left; }
  .stat .num{ font-family:var(--mono); font-size:24px; font-weight:700; color:var(--teal); }
  .stat .lbl{ font-family:var(--mono); font-size:10px; color:var(--muted); letter-spacing:1px; text-transform:uppercase; margin-top:2px; }
  .chip-list{ width:100%; max-width:340px; text-align:left; }
  .chip-list h3{ font-family:var(--mono); font-size:11px; color:var(--teal); letter-spacing:1px; text-transform:uppercase; margin-bottom:8px; }
  .chip{ display:inline-block; font-family:var(--mono); font-size:12px; color:#031014; background:var(--open); border-radius:20px; padding:4px 11px; margin:0 6px 6px 0; font-weight:700; }
  .rec-row{ font-family:var(--mono); font-size:12px; margin-bottom:8px; text-align:left; }
  .rec-row .rt{ font-weight:700; margin-bottom:2px; }
  .rec-row .rv{ color:var(--muted); word-break:break-all; }

  footer.section{ padding-bottom:60px; }
  footer .foot-title{ font-family:var(--mono); font-size:13px; color:var(--teal); margin-bottom:8px; }
  footer p{ font-family:var(--mono); font-size:11.5px; color:var(--muted); max-width:320px; line-height:1.7; }

  .fade-el{ transition:opacity .3s linear; }
</style>
</head>
<body>

<div id="canvas-wrap"></div>

<!-- 0: HERO -->
<section class="section" id="hero">
  <div class="caption-bar" style="pointer-events:auto;">
    <h1>Night <span>Tree</span></h1>
    <p class="tagline">roots that resolve, fruit that answers</p>
    <p class="body-text">Scroll to orbit around a living network map. Two separate tools, one tree.</p>
    <div class="scroll-hint" style="margin-top:8px;"><span class="arrow">↑</span>swipe up to orbit in</div>
  </div>
</section>

<!-- 1: ROOTS EXPLAIN — DNS TOOL -->
<section class="section" id="rootsExplain">
  <div class="caption-bar" style="pointer-events:auto;">
    <div class="sec-eyebrow">tool one — dns lookup</div>
    <h2 class="sec-heading">The roots find the <em>name</em></h2>
    <p class="body-text">A chain of lookups reaching down through DNS until a real address surfaces.</p>
    <div class="card" style="border:none; background:transparent; padding:10px 0 0; backdrop-filter:none;">
      <label>Domain</label>
      <input id="domainInput" value="google.com">
      <button class="btn" id="dnsBtn">Look Up DNS Records</button>
    </div>
  </div>
</section>

<!-- 2: ROOTS LIVE -->
<section class="section" id="rootsLive">
  <div class="hud fade-el" id="rootsHud"><h2>$ roots --resolve</h2><p>Live DNS records for your domain, glowing beneath the tree. Tap any root to read it.</p></div>
  <div class="status fade-el" id="rootsStatus">
    <div class="big" id="domainLabel">—</div>
    <div class="row"><span>IP address</span><b id="ipLabel">—</b></div>
    <div class="row"><span>mail servers</span><b id="mxLabel">—</b></div>
    <div class="row"><span>name servers</span><b id="nsLabel">—</b></div>
    <div class="row"><span>other records</span><b id="otherLabel">—</b></div>
  </div>
  <div class="legend fade-el" id="typeLegend"></div>
</section>

<!-- 3: TRUNK -->
<section class="section" id="trunk">
  <div class="caption-bar">
    <div class="sec-eyebrow">rising</div>
    <h2 class="sec-heading">The trunk carries <em>everything</em></h2>
    <p class="body-text">Every request that reaches the fruit passed through here first.</p>
  </div>
</section>

<!-- 4: CANOPY EXPLAIN — PORT SCAN TOOL -->
<section class="section" id="canopyExplain">
  <div class="caption-bar" style="pointer-events:auto;">
    <div class="sec-eyebrow">tool two — port scan</div>
    <h2 class="sec-heading">The fruit is a <em>port</em></h2>
    <p class="body-text">Each one hangs at a fixed number. Some let you in.</p>
    <div class="card" style="border:none; background:transparent; padding:10px 0 0; backdrop-filter:none;">
      <label>Target IP</label>
      <input id="ipInput" value="127.0.0.1">
      <div class="row2">
        <div><label>Start Port</label><input id="startPort" type="number" value="20" min="1" max="65535"></div>
        <div><label>End Port</label><input id="endPort" type="number" value="100" min="1" max="65535"></div>
      </div>
      <button class="btn" id="growBtn">Grow the Fruit</button>
    </div>
  </div>
</section>

<!-- 5: CANOPY LIVE -->
<section class="section" id="canopyLive">
  <div class="hud fade-el" id="canopyHud"><h2>$ canopy --scan</h2><p>Every port is a piece of fruit. Silver means unscanned, cyan means open, deep blue means closed. Open ports fall to the ground.</p><p id="sampledNote" style="color:var(--teal); margin-top:6px;"></p></div>
  <div class="status fade-el" id="canopyStatus">
    <div class="big" id="scanCount">0 / 0</div>
    <div>ports scanned</div>
    <div class="row"><span>target</span><b id="targetLabel">—</b></div>
    <div class="row"><span>open</span><b id="openLabel" style="color:var(--open)">0</b></div>
  </div>
  <div class="legend fade-el" id="portLegend">
    <span><i class="dot" style="background:var(--pend); color:var(--pend)"></i>unscanned</span>
    <span><i class="dot" style="background:var(--open); color:var(--open)"></i>open</span>
    <span><i class="dot" style="background:var(--closed); color:var(--closed)"></i>closed</span>
  </div>
</section>

<!-- 6: FRUIT FOCUS -->
<section class="section" id="fruitFocus">
  <div class="caption-bar">
    <div class="sec-eyebrow">closer still</div>
    <h2 class="sec-heading">Tap a fruit. <em>Look inside.</em></h2>
    <p class="body-text">Tap any fruit or glowing root, anywhere — the tree pulls you in close.</p>
  </div>
</section>

<!-- 7: RESULTS -->
<section class="section" id="results">
  <div class="caption-bar" style="pointer-events:auto; max-height:56vh; overflow-y:auto;">
    <div class="sec-eyebrow">pulling back</div>
    <h2 class="sec-heading">What the tree <em>knows</em></h2>
    <div class="stat-grid">
      <div class="stat"><div class="num" id="statTotal">0</div><div class="lbl">ports checked</div></div>
      <div class="stat"><div class="num" id="statOpen" style="color:var(--open)">0</div><div class="lbl">open</div></div>
    </div>
    <div class="chip-list"><h3>Open ports</h3><div id="openChips">—</div></div>
    <div class="chip-list" style="margin-top:18px;"><h3>DNS records</h3><div id="dnsList">—</div></div>
  </div>
</section>

<!-- 8: FOOTER -->
<footer class="section" id="footer">
  <div class="caption-bar">
    <div class="foot-title">$ night-tree</div>
    <p>A cybersecurity portfolio piece — DNS roots are real and live. Port results are simulated, since browsers can't open raw sockets.</p>
  </div>
</footer>

<div id="fruitInfo">
  <div class="port-num" id="fiPort">—</div>
  <div class="port-name" id="fiName">—</div>
  <div class="port-status" id="fiStatus">—</div>
  <div class="port-desc" id="fiDesc"></div>
  <button id="backBtn">← Back to orbit</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
  // ============ SCENE SETUP ============
  const wrap = document.getElementById('canvas-wrap');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x050810, 0.022);

  const camera = new THREE.PerspectiveCamera(52, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ antialias:true, alpha:true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  wrap.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0x223355, 1.0));
  const moon = new THREE.DirectionalLight(0xbcd8ff, 1.0);
  moon.position.set(10, 18, 6);
  scene.add(moon);
  const glowFill = new THREE.PointLight(0x2DD4BF, 0.9, 40);
  glowFill.position.set(-6, 4, -6);
  scene.add(glowFill);

  // ground: subtle reflective disc
  const ground = new THREE.Mesh(
    new THREE.CircleGeometry(10, 48),
    new THREE.MeshStandardMaterial({ color:0x0a1220, roughness:0.6, metalness:0.3, transparent:true, opacity:0.55 })
  );
  ground.rotation.x = -Math.PI / 2;
  scene.add(ground);
  const groundRing = new THREE.Mesh(
    new THREE.RingGeometry(4.6, 4.75, 64),
    new THREE.MeshBasicMaterial({ color:0x2DD4BF, side:THREE.DoubleSide, transparent:true, opacity:0.3 })
  );
  groundRing.rotation.x = -Math.PI / 2;
  scene.add(groundRing);

  // starfield
  const starGeo = new THREE.BufferGeometry();
  const starCount = 1100;
  const starPos = new Float32Array(starCount * 3);
  for(let i=0;i<starCount;i++){
    starPos[i*3]=(Math.random()-0.5)*140; starPos[i*3+1]=Math.random()*70-10; starPos[i*3+2]=(Math.random()-0.5)*140;
  }
  starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
  const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({ color:0x3b4a63, size:0.09 }));
  scene.add(stars);

  // fireflies — small drifting glow points around the tree
  const fireflyCount = 60;
  const fireflyGeo = new THREE.BufferGeometry();
  const fireflyPos = new Float32Array(fireflyCount * 3);
  const fireflyPhase = [];
  for(let i=0;i<fireflyCount;i++){
    const a = Math.random()*Math.PI*2, r = 3 + Math.random()*6, y = Math.random()*8 - 1;
    fireflyPos[i*3]=Math.cos(a)*r; fireflyPos[i*3+1]=y; fireflyPos[i*3+2]=Math.sin(a)*r;
    fireflyPhase.push(Math.random()*Math.PI*2);
  }
  fireflyGeo.setAttribute('position', new THREE.BufferAttribute(fireflyPos, 3));
  const fireflies = new THREE.Points(fireflyGeo, new THREE.PointsMaterial({ color:0x7dd3fc, size:0.14, transparent:true, opacity:0.85 }));
  scene.add(fireflies);

  // ============ TREE ============
  const treeGroup = new THREE.Group();
  scene.add(treeGroup);

  const trunkHeight = 3.1;

  function squashPoint(p, originY, flattenY, widenXZ){
    return new THREE.Vector3(p.x * widenXZ, originY + (p.y - originY) * flattenY, p.z * widenXZ);
  }

  // -- cone-sampling helper: rotate a direction by polar/azimuth angles --
  function rotateDirection(dir, polarAngle, azimuthAngle){
    const arbitrary = Math.abs(dir.y) < 0.99 ? new THREE.Vector3(0,1,0) : new THREE.Vector3(1,0,0);
    const perp1 = new THREE.Vector3().crossVectors(dir, arbitrary).normalize();
    const perp2 = new THREE.Vector3().crossVectors(dir, perp1).normalize();
    return dir.clone().multiplyScalar(Math.cos(polarAngle))
      .add(perp1.multiplyScalar(Math.sin(polarAngle) * Math.cos(azimuthAngle)))
      .add(perp2.multiplyScalar(Math.sin(polarAngle) * Math.sin(azimuthAngle)))
      .normalize();
  }

  // -- recursive branch skeleton: returns {segments, tips, joints} --
  // thick upper-level branches get a gentle organic bend + joint sphere;
  // thin twigs stay single straight segments to keep mesh count sane
  function generateSkeleton(origin, initialDir, initialLen, initialRadius, depth, branchFactor, spreadDeg, lenFalloff, radiusFalloff){
    const segments = [], tips = [], joints = [];
    function recurse(start, dir, len, radius, d){
      const bendEligible = d >= depth - 1; // only the first couple of levels bend
      let end, endDir;

      if(bendEligible){
        const bendAngle = THREE.MathUtils.degToRad(5 + Math.random()*12);
        const bendAzimuth = Math.random() * Math.PI * 2;
        const midDir = rotateDirection(dir, bendAngle, bendAzimuth);
        const mid = start.clone().add(midDir.clone().multiplyScalar(len * 0.52));
        endDir = rotateDirection(midDir, bendAngle * 0.5, bendAzimuth + 1.3 + Math.random());
        end = mid.clone().add(endDir.clone().multiplyScalar(len * 0.48));
        segments.push({ start, end:mid, radius });
        segments.push({ start:mid, end, radius: radius * 0.93 });
        joints.push({ pos:mid, radius: radius * 0.95 });
      } else {
        end = start.clone().add(dir.clone().multiplyScalar(len));
        endDir = dir;
        segments.push({ start, end, radius });
      }

      if(d <= 0){ tips.push({ pos:end, dir:endDir }); return; }

      // irregular branch count — not every node forks the same way
      let children = branchFactor;
      const roll = Math.random();
      if(roll < 0.12) children = 1;
      else if(roll < 0.32) children = Math.max(1, branchFactor - 1);
      else if(roll < 0.48) children = branchFactor + 1;

      for(let c = 0; c < children; c++){
        const azimuth = (c / children) * Math.PI * 2 + Math.random() * 1.1;
        const polar = THREE.MathUtils.degToRad(spreadDeg * (0.5 + Math.random() * 0.8));
        const newDir = rotateDirection(endDir, polar, azimuth);
        recurse(end, newDir, len * lenFalloff * (0.82 + Math.random()*0.36), radius * radiusFalloff * (0.88 + Math.random()*0.24), d - 1);
      }
    }
    recurse(origin, initialDir, initialLen, initialRadius, depth);
    return { segments, tips, joints };
  }

  function makeBranchMesh(seg, material){
    const dir = new THREE.Vector3().subVectors(seg.end, seg.start);
    const length = dir.length();
    if(length < 0.001) return null;
    const geo = new THREE.CylinderGeometry(Math.max(0.02, seg.radius * 0.62), Math.max(0.03, seg.radius), length, 6, 1);
    const mesh = new THREE.Mesh(geo, material);
    const mid = seg.start.clone().add(seg.end).multiplyScalar(0.5);
    mesh.position.copy(mid);
    mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), dir.normalize());
    return mesh;
  }

  const barkColors = [0x1e293b, 0x223349, 0x1a2436, 0x25344a];
  const barkMats = barkColors.map(c => new THREE.MeshStandardMaterial({ color:c, roughness:0.8, metalness:0.2, emissive:0x0f2436, emissiveIntensity:0.1
